  "held_or_unchanged": [
    {
      "title": "The Human Thread",
      "finding": "National Geographic explicitly advertises the call and December 1 date. The programme-specific application portal served a JavaScript shell without visible programme details or intake, so it was held."
    },
    {
      "title": "Global EbA, British Council Green and Digital, and JIF Circularity",
      "finding": "Official-linked application portals returned HTTP 403. The listings remain unconfirmed."
    },
    {
      "title": "UNESCO SCRS Research Continuity Grants",
      "finding": "Official-linked Microsoft Forms endpoint returned HTTP 200 but the rendered form and acceptance state were unconfirmed."
    },
    {
      "title": "D-Prize and Keeling Curve Prize",
      "finding": "Prior ambiguity remained on the midnight cutoff and application cap respectively. They were not promoted to actionable."
    },
    {
      "title": "REACT DIFEC",
      "finding": "Linked AECF portal returned HTTP 200 but no matching DIFEC application listing was visible."
    },
    {
      "title": "Rufford Small Grants",
      "finding": "Official page confirms rolling intake and linked account page is reachable."
    },
    {
      "title": "Nexa Lighthouse",
      "finding": "Official announcement limits this call to Asia and the Pacific."
    }
  ],
  "limitations": [
    "Hourly verifier again overwrote the Lacuna application link with a webinar, the Cities Deliver proposal deadline with its questions cutoff, and removed precise timestamps. The daily corrections were confirmed in production. The underlying hourly behavior remains."
  ],
