# Dev-only (Vite loads .env.development for `vite dev`, never for a build).
#
# In production the panel is served under /admin/ of the public site's own host,
# so cross-app links are plain rooted paths and this stays unset. In dev the two
# apps are separate servers on separate ports, so the panel has to be told where
# the public site is — otherwise signing in redirects to :8081/auth, which this
# server (base "/admin/") answers with
# "did you mean to visit /admin/auth?next=%2Fadmin%2F instead?".
VITE_SITE_URL=http://localhost:8080
