{
  "name": "cresciva-api",
  "version": "0.1.0",
  "description": "NestJS + Drizzle API in front of the Cresciva Supabase Postgres (Plan 07).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/Backend/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:pull": "drizzle-kit pull",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "drizzle-orm": "^0.44.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.31.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.7.0",
    "vitest": "^3.2.4"
  }
}
