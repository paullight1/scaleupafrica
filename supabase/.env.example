# =============================================================================
# Edge function secrets. Copy to supabase/.env for local runs:
#
#   supabase functions serve --env-file supabase/.env
#
# supabase/.env is gitignored — NEVER commit a real key. Production values are
# set once with:
#
#   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically; they do not belong in this file.
# =============================================================================

# --- Resend (transactional email) --------------------------------------------
# https://resend.com/api-keys — a "Sending access" key is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The sending identity. The domain MUST be verified in Resend or every send 403s.
EMAIL_FROM=Cresciva <hello@cresciva.com>
EMAIL_REPLY_TO=hello@cresciva.com

# Internal inbox that receives contact-form notifications.
EMAIL_TEAM_INBOX=hello@cresciva.com

# Public site origin used to build links inside emails. No trailing slash.
SITE_URL=https://cresciva.com

# HMAC secret for unsubscribe tokens AND the IP-hash salt in send-email.
# Any long random string: `openssl rand -hex 32`. Rotating it invalidates every
# unsubscribe link already sitting in people's inboxes — treat it as permanent.
EMAIL_TOKEN_SECRET=

# --- Brevo (marketing campaigns) --------------------------------------------
# Marketing API key. Keep separate from the Resend transactional credential.
BREVO_API_KEY=

# The authoritative Cresciva newsletter list and verified sender IDs in Brevo.
BREVO_LIST_ID=
BREVO_SENDER_ID=

# Long random bearer token configured on Brevo's secured marketing webhook.
BREVO_WEBHOOK_TOKEN=

# --- Existing function secrets (for reference) -------------------------------
# PAYSTACK_SECRET_KEY=
# LOVABLE_API_KEY=
