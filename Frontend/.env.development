# Dev-only (Vite loads .env.development for `vite dev`, never for a build).
#
# In production the admin panel is served under /admin/ of this same host, so the
# header/footer "Admin" links are plain rooted paths and this stays unset. In dev
# the panel is its own server on :8081, so the site has to be told where it is.
VITE_ADMIN_URL=http://localhost:8081
